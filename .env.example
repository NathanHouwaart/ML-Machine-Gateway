# Public address and port used by the one and only HTTP gateway on this server.
# Keep port 80 in production. A local test can use 127.0.0.1:8098 instead.
GATEWAY_BIND=192.168.0.189:80

# Persistent host storage. This is never a Docker-managed measurement volume.
TBDAQ_DATA_ROOT=/srv/testbenchdaq

# Populate these with immutable GHCR release tags when enabling the portal.
TBDAQ_PORTAL_API_IMAGE=ghcr.io/nathanhouwaart/testbenchdaq-portal-api:main
TBDAQ_PORTAL_WEB_IMAGE=ghcr.io/nathanhouwaart/testbenchdaq-portal-web:main
